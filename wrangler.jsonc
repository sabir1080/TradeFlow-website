{
  // Cloudflare Workers config for the "tradeflow-website" Worker.
  //
  // "main" runs src/worker.js for EVERY request. It handles the feedback
  // API and the password-gated /admin dashboard, then falls through to
  // env.ASSETS.fetch() for everything else — so the static site (assets
  // directory "./") is served exactly as before for all other routes.
  //
  // The D1 database below (tradeflow_feedback) has been created in the
  // Cloudflare account. Still required before feedback fully works:
  //   1. wrangler d1 migrations apply tradeflow_feedback --remote
  //   2. wrangler secret put ADMIN_PASSWORD
  // See README "Feedback System" for full detail.
  "name": "tradeflow-website",
  "compatibility_date": "2024-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradeflow_feedback",
      "database_id": "061774fa-f246-461b-8c2e-7f7fef37a4b4"
    }
  ]
}
